:root {
    --primary-color: #d4af37; /* Dourado Tequila */
    --bg-color: #121212;
    --card-bg: #1e1e1e;
    --text-color: #f5f5f5;
    --accent-color: #e67e22;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
}

header {
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), 
                url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
    height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
}

header h1 {
    font-size: 3rem;
    color: var(--primary-color);
    margin-bottom: 10px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
}

header p {
    font-size: 1.2rem;
    max-width: 600px;
}

.container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

.section-title {
    text-align: center;
    font-size: 2rem;
    color: var(--primary-color);
    margin-bottom: 30px;
}

/* Galeria de Fotos */
.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 50px;
}

.gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    cursor: pointer;
}

.gallery-item img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.gallery-item:hover img {
    transform: scale(1.08);
}

.gallery-caption {
    position: absolute;
    bottom: 0;
    background: rgba(0,0,0,0.75);
    width: 100%;
    padding: 10px;
    text-align: center;
    font-weight: bold;
}

/* Seção de Vídeo */
.video-section {
    background-color: var(--card-bg);
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 50px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}

.video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* Proporção 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
}

.video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
}

/* Área Interativa */
.interactive-section {
    text-align: center;
    background: linear-gradient(135deg, #1e1e1e, #2a2a2a);
    padding: 40px;
    border-radius: 12px;
    border: 1px solid var(--primary-color);
}

.btn-celebrate {
    background-color: var(--primary-color);
    color: #000;
    border: none;
    padding: 15px 30px;
    font-size: 1.2rem;
    font-weight: bold;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 20px;
}

.btn-celebrate:hover {
    background-color: var(--accent-color);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(230, 126, 34, 0.4);
}

#toast-message {
    margin-top: 25px;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--accent-color);
    min-height: 40px;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: #0a0a0a;
    color: #777;
    margin-top: 50px;
}
